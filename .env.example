# Canonical origin used for metadata, sitemap.xml, and robots.txt.
#
# Read at BUILD time, not runtime: NEXT_PUBLIC_* values are inlined into the
# output, and the sitemap and canonical tags are generated during `next build`.
# Setting it only in the runtime environment has no effect — the origin has to
# be present for the build that produces the artifact you deploy.
#
# Unset, absolute URLs fall back to http://localhost:3000, which is obviously
# wrong in production output rather than silently pointing at another domain.
NEXT_PUBLIC_SITE_URL=https://misaf.github.io/vendra-ecosystem-docs

# Path prefix the site is served under. A GitHub Pages *project* site lives at
# /<repo>, so this must match the repository name. Set BASE_PATH= (empty) when
# moving to a custom domain or a <user>.github.io user site.
BASE_PATH=/vendra-ecosystem-docs

{
  "name": "vendra-ecosystem-docs",
  "version": "1.0.0",
  "description": "Documentation for the Vendra platform, controller, storefront, and operations.",
  "license": "ISC",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next",
    "build": "next build",
    "postbuild": "pagefind --site out --output-path out/_pagefind",
    "start": "next start",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "check:links": "node scripts/check-links.mjs",
    "check:drift": "node scripts/check-drift.mjs",
    "check:html": "node scripts/check-html.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run check:links && npm run check:drift && npm test && npm run build && npm run check:html"
  },
  "dependencies": {
    "next": "^16.2.12",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3"
  }
}
